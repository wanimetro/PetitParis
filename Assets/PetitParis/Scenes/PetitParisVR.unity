  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>PETIT PARIS</b>\n\uC791\uC740 \uC950\uAC00 \uB418\uC5B4 \uBE44\uC2A4\uD2B8\uB85C \uC8FC\uBC29\uC758 \uCE58\uC988\uB97C \uCC3E\uC544\uAC00\uC138\uC694\n\uBE75 \uBD80\uC2A4\uB7EC\uAE30\uB97C \uBAA8\uC73C\uACE0, \uC0AC\uB78C \uB208\uC5D0 \uB744\uC9C0 \uB9C8\uC138\uC694!\n\n\uC67C\uCABD \uC2A4\uD2F1  \uC774\uB3D9\n\uC624\uB978\uCABD \uC2A4\uD2F1  30\uB3C4 \uD68C\uC804\n\uC624\uB978\uCABD \uD2B8\uB9AC\uAC70  \uC21C\uAC04 \uC9C8\uC8FC\n\uC67C\uCABD \uADF8\uB9BD \uB204\uB974\uACE0 \uC788\uAE30  \uB2EC\uB9AC\uAE30\nA  \uC810\uD504     B  \uC6C5\uD06C\uB9AC\uAE30\n\uC67C\uCABD \uBA54\uB274 \uAE38\uAC8C  \uC2DC\uC810 \uB2E4\uC2DC \uB9DE\uCD94\uAE30\n(PC: WASD \uC774\uB3D9, Shift \uB2EC\uB9AC\uAE30, \uD074\uB9AD \uC9C8\uC8FC, \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uB4DC\uB798\uADF8\uB85C \uB458\uB7EC\uBCF4\uAE30)"
